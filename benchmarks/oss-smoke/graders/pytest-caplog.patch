@@ -0,0 +1,34 @@
+import logging
+
+import pytest
+
+
+class DropAllFilter(logging.Filter):
+    def filter(self, record: logging.LogRecord) -> bool:
+        return False
+
+
+def test_nested_filtering_keeps_outer_filter_active(caplog: pytest.LogCaptureFixture) -> None:
+    logger = logging.getLogger(__name__)
+    drop_all = DropAllFilter()
+
+    with caplog.filtering(drop_all):
+        logger.warning("outer-before")
+        with caplog.filtering(drop_all):
+            logger.warning("inner")
+        logger.warning("outer-after")
+
+    assert caplog.records == []
+
+
+def test_filtering_does_not_remove_preexisting_filter(caplog: pytest.LogCaptureFixture) -> None:
+    logger = logging.getLogger(__name__)
+    drop_all = DropAllFilter()
+    caplog.handler.addFilter(drop_all)
+    try:
+        with caplog.filtering(drop_all):
+            logger.warning("inside")
+        logger.warning("after")
+        assert caplog.records == []
+    finally:
+        caplog.handler.removeFilter(drop_all)
